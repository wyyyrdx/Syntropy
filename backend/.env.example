PORT=3000
NODE_ENV=development

# Database
DB_PATH=./data/syntropy.db

# Uploads
UPLOAD_DIR=./uploads

# Auth
# Generate a real secret for production, e.g.: openssl rand -hex 32
JWT_SECRET=change-me-in-production

# AI service (see ai/generate.js)
# Full URL including the /generate path.
AI_SERVICE_URL=http://ai-service:8000/generate
# Where the AI service can find uploaded images inside its own container -
# must point at the same shared uploads volume as the backend.
AI_UPLOADS_PATH_PREFIX=/app/uploads
# Set to true to bypass AI API key during local dev and testing
MOCK_AI=false

# CORS - comma-separated list of allowed origins.
# Leave unset during local dev to allow all origins.
CORS_ORIGIN=http://localhost:5173
