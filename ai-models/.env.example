# Syntropy AI Extraction Service Environment Configuration
# Obtain your Gemini API Key at https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Model to use. The extraction pipeline also has compatible fallback models.
GEMINI_MODEL=gemini-3.1-flash-lite

# Set to true to run in offline mock mode without an API key (returns sample concept graphs)
MOCK_AI=false
